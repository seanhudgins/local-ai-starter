# Secrets: never commit (keys live in Credential Manager / Keychain)
.env
.env.*
*.key
*.pem
secrets/
**/credentials*

# Models and big data stay out of git
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth

# Logs can contain task metadata; keep local
logs/*.csv
logs/**/raw/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json

# Claude Code local-only settings
.claude/settings.local.json

# More secrets and build files
service_account*.json
id_rsa
id_ed25519
node_modules/

# Open WebUI secret key (lives in D:\ai\open-webui\data; never in the repo)
.webui_secret_key

# Eval results: the database is a local cache rebuilt from evals/runs/*.jsonl (committed) with
# `uv run evals/run.py rebuild`; judging/ holds scratch files for grading by hand.
evals/results.db
evals/results.*.bak
evals/judging/
