#!/bin/sh
# After `git pull` (or any merge): run checks another machine left for this one in ops/inbox.json.
# Only predefined modelcheck.py checks can run (see ops/run_inbox.py). Never blocks the pull.
if [ -f ops/run_inbox.py ] && command -v uv >/dev/null 2>&1; then
    uv run --quiet ops/run_inbox.py --hook || echo "Some inbox tasks failed; see ops/results/." >&2
fi
exit 0
